# ===== 前端（Vite 开发/构建时从仓库根读取） =====
# 后端 API 地址；开发环境可写成 http://localhost:${PORT} 跟随下面的 PORT
VITE_API_PATH=http://localhost:8080

# ===== 后端 =====
# 本地开发监听端口（bun run dev）；生产由平台注入 PORT
PORT=8080

# JWT signing secret. Required — the server refuses to boot in production without it.
JWT_SECRET=replace-me-with-a-long-random-string

# Lifetime of the login token in days. There is no server-side revocation, so keep this short.
# JWT_EXPIRES_DAYS=7

# Storage driver: "sqlite" (local dev, default) | "neon" (production: Neon Postgres + Vercel Blob files)
STORAGE_DRIVER=sqlite

# Neon Postgres connection string (required when STORAGE_DRIVER=neon)
DATABASE_URL=postgresql://user:pass@host.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host.neon.tech/neondb?sslmode=require

# Vercel Blob read-write token for file uploads (required when STORAGE_DRIVER=neon)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Public base URL used as OIDC issuer (defaults to the request origin; set when behind proxies)
# OAUTH_ISSUER=https://api.example.com

# Frontend login URL used when the authorization endpoint needs the user to sign in.
# Defaults to /login on the API origin; set this when the frontend is served from a different domain.
# OAUTH_LOGIN_URL=https://app.example.com/login

# Comma-separated list of origins allowed in CORS (include the frontend URL).
# Auth is a pure Authorization: Bearer channel with no cookies, so this only gates cross-origin fetch.
# ALLOWED_ORIGINS=https://app.example.com
