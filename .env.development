# web 与 server 共用；vite 通过 envDir、server 通过显式 dotenv 从仓库根读取
# 后端端口：改这一处，VITE_API_PATH 自动跟随
PORT=8081
VITE_API_PATH=http://localhost:${PORT}
VITE_GITEA_PATH=http://localhost:3000

STORAGE_DRIVER=sqlite
OAUTH_LOGIN_URL=http://localhost:5174/login
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
