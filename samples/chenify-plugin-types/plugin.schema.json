{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ChenifyHub UI 插件清单",
    "type": "object",
    "required": [
        "id",
        "name",
        "ui"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "description": "唯一标识，只能是小写字母、数字与 . _ -，且以字母或数字开头，最长 64 位。重复安装视为更新。"
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "description": "展示名。"
        },
        "version": {
            "type": "string",
            "default": "0.0.0"
        },
        "author": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "ui": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "style": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "注入 <head> 的 CSS 文件路径，卸载时自动移除。"
                },
                "components": {
                    "type": "object",
                    "description": "插槽名 → 替换宿主组件的 .tsx 模块路径。ui.style 与 ui.components 至少要有一个。",
                    "properties": {
                        "button": {
                            "type": "string",
                            "default": "ui/button.tsx",
                            "markdownDescription": "替换宿主的 `Button`（宿主文件 `button.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"button\">`。"
                        },
                        "card": {
                            "type": "string",
                            "default": "ui/card.tsx",
                            "markdownDescription": "替换宿主的 `Card`（宿主文件 `card.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"card\">`。"
                        },
                        "cardHeader": {
                            "type": "string",
                            "default": "ui/cardHeader.tsx",
                            "markdownDescription": "替换宿主的 `CardHeader`（宿主文件 `card.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"cardHeader\">`。"
                        },
                        "cardFooter": {
                            "type": "string",
                            "default": "ui/cardFooter.tsx",
                            "markdownDescription": "替换宿主的 `CardFooter`（宿主文件 `card.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"cardFooter\">`。"
                        },
                        "cardTitle": {
                            "type": "string",
                            "default": "ui/cardTitle.tsx",
                            "markdownDescription": "替换宿主的 `CardTitle`（宿主文件 `card.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"cardTitle\">`。"
                        },
                        "cardAction": {
                            "type": "string",
                            "default": "ui/cardAction.tsx",
                            "markdownDescription": "替换宿主的 `CardAction`（宿主文件 `card.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"cardAction\">`。"
                        },
                        "cardDescription": {
                            "type": "string",
                            "default": "ui/cardDescription.tsx",
                            "markdownDescription": "替换宿主的 `CardDescription`（宿主文件 `card.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"cardDescription\">`。"
                        },
                        "cardContent": {
                            "type": "string",
                            "default": "ui/cardContent.tsx",
                            "markdownDescription": "替换宿主的 `CardContent`（宿主文件 `card.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"cardContent\">`。"
                        },
                        "badge": {
                            "type": "string",
                            "default": "ui/badge.tsx",
                            "markdownDescription": "替换宿主的 `Badge`（宿主文件 `badge.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"badge\">`。"
                        },
                        "input": {
                            "type": "string",
                            "default": "ui/input.tsx",
                            "markdownDescription": "替换宿主的 `Input`（宿主文件 `input.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"input\">`。"
                        },
                        "label": {
                            "type": "string",
                            "default": "ui/label.tsx",
                            "markdownDescription": "替换宿主的 `Label`（宿主文件 `label.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"label\">`。"
                        },
                        "separator": {
                            "type": "string",
                            "default": "ui/separator.tsx",
                            "markdownDescription": "替换宿主的 `Separator`（宿主文件 `separator.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"separator\">`。"
                        },
                        "skeleton": {
                            "type": "string",
                            "default": "ui/skeleton.tsx",
                            "markdownDescription": "替换宿主的 `Skeleton`（宿主文件 `skeleton.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"skeleton\">`。"
                        },
                        "checkbox": {
                            "type": "string",
                            "default": "ui/checkbox.tsx",
                            "markdownDescription": "替换宿主的 `Checkbox`（宿主文件 `checkbox.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"checkbox\">`。"
                        },
                        "tabs": {
                            "type": "string",
                            "default": "ui/tabs.tsx",
                            "markdownDescription": "替换宿主的 `Tabs`（宿主文件 `tabs.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"tabs\">`。"
                        },
                        "tabsList": {
                            "type": "string",
                            "default": "ui/tabsList.tsx",
                            "markdownDescription": "替换宿主的 `TabsList`（宿主文件 `tabs.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"tabsList\">`。"
                        },
                        "tabsTrigger": {
                            "type": "string",
                            "default": "ui/tabsTrigger.tsx",
                            "markdownDescription": "替换宿主的 `TabsTrigger`（宿主文件 `tabs.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"tabsTrigger\">`。"
                        },
                        "tabsContent": {
                            "type": "string",
                            "default": "ui/tabsContent.tsx",
                            "markdownDescription": "替换宿主的 `TabsContent`（宿主文件 `tabs.tsx`），模块的 default 导出即替换组件。props 类型见 `SlotProps<\"tabsContent\">`。"
                        }
                    },
                    "additionalProperties": false
                }
            }
        },
        "files": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "只有「从 URL 安装」才需要：列出包内全部文件，且必须包含 plugin.json 自己。"
        }
    },
    "x-slots": [
        "badge",
        "button",
        "card",
        "cardAction",
        "cardContent",
        "cardDescription",
        "cardFooter",
        "cardHeader",
        "cardTitle",
        "checkbox",
        "input",
        "label",
        "separator",
        "skeleton",
        "tabs",
        "tabsContent",
        "tabsList",
        "tabsTrigger"
    ],
    "x-slot-modules": {
        "button.tsx": [
            "Button"
        ],
        "card.tsx": [
            "Card",
            "CardHeader",
            "CardFooter",
            "CardTitle",
            "CardAction",
            "CardDescription",
            "CardContent"
        ],
        "badge.tsx": [
            "Badge"
        ],
        "input.tsx": [
            "Input"
        ],
        "label.tsx": [
            "Label"
        ],
        "separator.tsx": [
            "Separator"
        ],
        "skeleton.tsx": [
            "Skeleton"
        ],
        "checkbox.tsx": [
            "Checkbox"
        ],
        "tabs.tsx": [
            "Tabs",
            "TabsList",
            "TabsTrigger",
            "TabsContent"
        ]
    }
}
