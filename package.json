{
    "name": "chenify-hub",
    "private": true,
    "type": "module",
    "workspaces": [
        "server"
    ],
    "scripts": {
        "dev": "vite web & bun --watch server/index.ts & wait",
        "dev:web": "vite web",
        "dev:server": "bun --watch server/index.ts",
        "start": "bun server/index.ts",
        "prebuild": "node web/scripts/gen-plugin-types.ts",
        "build": "tsc -b web && vite build web",
        "build:server": "cd server && bun build index.ts --outdir dist --minify --target bun",
        "seed": "cd server && bun seed.ts",
        "db:push": "cd server && drizzle-kit push",
        "db:generate": "cd server && drizzle-kit generate",
        "db:migrate": "cd server && drizzle-kit migrate",
        "db:studio": "cd server && drizzle-kit studio",
        "works:push": "cd server && drizzle-kit push --config drizzle-works.config.ts",
        "works:generate": "cd server && drizzle-kit generate --config drizzle-works.config.ts",
        "works:migrate": "cd server && drizzle-kit migrate --config drizzle-works.config.ts",
        "works:studio": "cd server && drizzle-kit studio --config drizzle-works.config.ts",
        "db:push:neon": "cd server && drizzle-kit push --config drizzle-neon.config.ts",
        "db:generate:neon": "cd server && drizzle-kit generate --config drizzle-neon.config.ts",
        "body:unescape": "cd server && bun unescape-bodies.ts",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "gen:plugin-types": "node web/scripts/gen-plugin-types.ts",
        "typecheck:plugins": "node web/scripts/gen-plugin-types.ts && tsc -p samples/tsconfig.json"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@msgpack/msgpack": "^3.1.3",
        "@neondatabase/serverless": "^1.1.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tiptap/core": "^3.30.2",
        "@tiptap/extension-code-block-lowlight": "^3.29.2",
        "@tiptap/extension-image": "^3.31.3",
        "@tiptap/extension-link": "^3.29.2",
        "@tiptap/extension-list": "~3.30.2",
        "@tiptap/extension-placeholder": "^3.29.2",
        "@tiptap/extension-table": "~3.30.2",
        "@tiptap/markdown": "^3.29.2",
        "@tiptap/pm": "^3.29.2",
        "@tiptap/react": "^3.29.2",
        "@tiptap/starter-kit": "^3.29.2",
        "@vercel/blob": "^2.8.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/addon-web-links": "^0.12.0",
        "@xterm/xterm": "^6.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "fflate": "^0.8.3",
        "hono": "^4.13.3",
        "jose": "^6.2.9",
        "katex": "^0.18.1",
        "lowlight": "^2",
        "lucide-react": "^1.28.0",
        "mermaid": "^12.0.0",
        "next-themes": "^0.4.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-image-crop": "^11.1.2",
        "react-router-dom": "^7.18.2",
        "shadcn": "^4.16.1",
        "sonner": "^2.0.7",
        "sucrase": "^3.35.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "uuid": "^14.0.1",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@types/bun": "latest",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "better-sqlite3": "^13.0.3",
        "drizzle-kit": "^0.31.10",
        "typescript": "~6.0.2",
        "vite": "^8.2.0"
    }
}
